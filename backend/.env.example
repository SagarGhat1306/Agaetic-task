PORT=5000
CLIENT_URL=http://localhost:5173,https://your-frontend-domain.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
JWT_SECRET=put-a-long-random-string-here
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7
NODE_ENV=development

# Email for sending viewer logins (leave empty to skip sending)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
MAIL_FROM=Employee Directory <your-email@gmail.com>
